Subject: libgc: install pkginclude headers into /usr/include/gc

Upstream libgc installs its public headers into $(pkgincludedir), which
autoconf sets to $(includedir)/libgc-<version> (e.g. /usr/include/libgc-8.2.12).
Consumers that probe a fixed include path (such as w3m's configure, which
searches <prefix>/include and <prefix>/include/gc for gc.h) do not find them.

Install the pkginclude headers into $(includedir)/gc so that gc.h and
friends land in /usr/include/gc/, which w3m's default --with-gc search
(/usr/include/gc) resolves without any extra configure flag.

--- a/Makefile.am
+++ b/Makefile.am
@@ -39,6 +39,9 @@ AM_CPPFLAGS = \
 ## Initialize variables so that we can declare files locally.
 EXTRA_DIST =
 lib_LTLIBRARIES =
 include_HEADERS =
+# Install public headers into <includedir>/gc so that consumers probing a
+# fixed include path (e.g. w3m's configure searching /usr/include/gc for
+# gc.h) find them.
+pkgincludedir = $(includedir)/gc
 pkginclude_HEADERS =
 dist_noinst_HEADERS =
